{
  "version": 2,
  "builds": [
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/chat.js"
    }
  ]
}
{
  "routes": [
    {
      "src": "/ai.html",
      "dest": "/public/ai.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    }
  ]
}